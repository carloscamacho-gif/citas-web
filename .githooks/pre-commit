#!/usr/bin/env sh
# Red de verificación local (S3). Si algo falla, el commit se bloquea.
#   1) escaneo de secretos sobre lo que se va a commitear
#   2) lint (tsc), pruebas y build, cuando el commit toca codigo del frontend
set -eu
cd "$(git rev-parse --show-toplevel)"

echo "[pre-commit] 1/2 escaneando secretos..."
sh .githooks/secret-scan.sh

staged=$(git diff --cached --name-only --diff-filter=ACMR)
if ! printf '%s\n' "$staged" | grep -Eq '^(src/|index\.html$|package(-lock)?\.json$|tsconfig\.json$|vite\.config\.)'; then
  echo "[pre-commit] 2/2 sin cambios de codigo: se omiten lint, pruebas y build."
  exit 0
fi

if [ ! -d node_modules ]; then
  echo "[pre-commit] Falta node_modules: ejecuta 'npm install' primero." >&2
  exit 1
fi

echo "[pre-commit] 2/2 lint (tsc) + pruebas + build..."
if ! { npm run lint --silent && npm test --silent && npm run build --silent; }; then
  echo "" >&2
  echo "Commit bloqueado: fallo lint, pruebas o build. Corrigelo y vuelve a intentar." >&2
  exit 1
fi
echo "[pre-commit] OK"
